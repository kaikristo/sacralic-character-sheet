rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function character() {
      return request.resource.data.keys().hasOnly(['version', 'revision', 'json', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.revision is int
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 700000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/characters/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && character() && request.resource.data.revision == 1;
      allow update: if owner(uid) && character() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/images/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['version', 'parts', 'name'])
        && request.resource.data.version == 1
        && request.resource.data.parts is int
        && request.resource.data.parts > 0 && request.resource.data.parts <= 27
        && request.resource.data.name is string && request.resource.data.name.size() <= 160;
      match /chunks/{index} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 150000;
      }
    }
  }
}
